# Copy this file to .env and fill in your own values.
# The app runs fine without TMDB_API_KEY (uses a built-in fallback catalogue).

# Register at https://www.themoviedb.org/settings/api (free)
TMDB_API_KEY=

# Any long random string. Used by express-session to sign cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional; defaults to 3000
PORT=3000
