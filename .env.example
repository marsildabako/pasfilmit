# Copy to .env and fill in.
# The app runs without a TMDB key - it uses a built-in fallback list.

# Get one at https://www.themoviedb.org/settings/api (free)
TMDB_API_KEY=

# used to sign session cookies. any long random string works.
SESSION_SECRET=change-me-to-a-long-random-string

# defaults to 3000
PORT=3000
